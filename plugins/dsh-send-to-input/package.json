{
  "name": "@local/dsh-send-to-input",
  "version": "1.0.0",
  "private": true,
  "description": "发送到输入框 — 把右侧栏文档预览里选中的内容（或整篇文件）一键送进对话输入框",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-api-workspace-files"
      ]
    }
  }
}
